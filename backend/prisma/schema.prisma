generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dom_id      Int?
  jwtToken    String?
  role_id     Int?
  accessToken String?
  doms        doms?    @relation(fields: [dom_id], references: [id])
  roles       roles?   @relation(fields: [role_id], references: [id])
}

model doms {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  address     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  Users       Users[]
  experiences experiences[]
  machines    machines[]
  tickets     tickets[]
  DomeSyncLog DomeSyncLog[]
  domeGames   domeGames[]
}

model experiences {
  id           Int       @id @default(autoincrement())
  machineId    Int
  gameId       Int
  isFractioned Boolean   @default(false)
  isNext       Boolean   @default(false)
  isStarted    Boolean   @default(false)
  isEnded      Boolean   @default(false)
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  domeId       Int
  tickets      tickets[]
  doms         doms      @relation(fields: [domeId], references: [id], onDelete: SetDefault)
  games        games     @relation(fields: [gameId], references: [id], onDelete: SetDefault)
  machines     machines  @relation(fields: [machineId], references: [id], onDelete: SetDefault)
}

model gameTypes {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  games     games[]
}

model games {
  id            Int           @id @default(autoincrement())
  name          String
  price         Float
  playTime      Int
  gameTypeId    Int?
  age           Int?
  machineTypeId Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  experiences   experiences[]
  domeGames     domeGames[]
  gameTypes     gameTypes?    @relation(fields: [gameTypeId], references: [id])
  machineTypes  machineTypes? @relation(fields: [machineTypeId], references: [id])
}

model domeGames {
  id        Int      @id @default(autoincrement())
  domeId    Int
  gameId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  doms      doms     @relation(fields: [domeId], references: [id], onDelete: SetDefault)
  games     games    @relation(fields: [gameId], references: [id], onDelete: SetDefault)

  @@unique([domeId, gameId])
}

model machineChairs {
  id        Int       @id @default(autoincrement())
  name      String
  status    Int
  machineId Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  machines  machines  @relation(fields: [machineId], references: [id], onDelete: SetDefault)
  tickets   tickets[]
}

model machineTypes {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  games     games[]
  machines  machines[]
}

model machines {
  id            Int             @id @default(autoincrement())
  name          String
  alias         String          @unique
  machineTypeId Int
  domeId        Int?
  ticketNumber  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  experiences   experiences[]
  machineChairs machineChairs[]
  doms          doms?           @relation(fields: [domeId], references: [id])
  machineTypes  machineTypes    @relation(fields: [machineTypeId], references: [id])
}

model roles {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  Users     Users[]
}

model tickets {
  id              Int             @id @default(autoincrement())
  userId          Int?
  experienceId    Int
  alias           String
  isPaid          Boolean         @default(false)
  chairId         Int?
  couponId        Int?
  notes           String?
  price           Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  domeId          Int
  parentTicketId  Int?
  parentTicket    tickets?        @relation("FractionedTickets", fields: [parentTicketId], references: [id])
  childTickets    tickets[]       @relation("FractionedTickets")
  experiences     experiences     @relation(fields: [experienceId], references: [id], onDelete: SetDefault)
  machineChairs   machineChairs?  @relation(fields: [chairId], references: [id])
  doms            doms            @relation(fields: [domeId], references: [id], onDelete: SetDefault)
  coupons         coupons?        @relation(fields: [couponId], references: [id])
}

model coupons {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  discount    Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  tickets     tickets[]
}

model DomeSyncLog {
  id          Int      @id @default(autoincrement())
  domeId      Int
  lastSyncAt  DateTime // The lastSync time received from the server
  completedAt DateTime @default(now()) // When the sync completed
  isFirstSync Boolean  @default(true)
  wasSuccess  Boolean  @default(true)
  error       String?
  dataCount   Int?
  dome        doms     @relation(fields: [domeId], references: [id], onDelete: Cascade)

  @@index([domeId])
  @@index([completedAt])
}
