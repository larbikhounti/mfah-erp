generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  name        String
  password    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  jwtToken    String?
  role_id     Int?
  accessToken String?
  roles       roles?    @relation(fields: [role_id], references: [id])
}

model roles {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  Users       Users[]
  permissions Permission[]
}

enum PermissionModule {
  TRUCKS
  DRIVERS
  CLIENTS
  SUBCONTRACTORS
  CONTRACTOR_TRUCKS
  MISSIONS
  CLIENT_INVOICES
  SUBCONTRACTOR_BILLS
  DASHBOARD
  REPORTS
}

model Permission {
  id        Int              @id @default(autoincrement())
  roleId    Int
  module    PermissionModule
  canCreate Boolean          @default(false)
  canRead   Boolean          @default(false)
  canUpdate Boolean          @default(false)
  canDelete Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  roles     roles            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
}

enum TruckStatus {
  DISPO
  EN_MISSION
  MAINTENANCE
  INDISPONIBLE
}

model Truck {
  id              Int          @id @default(autoincrement())
  plateNumber     String       @unique
  type            String
  ptac            Int
  status          TruckStatus  @default(DISPO)
  note            String?
  insuranceExpiry DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  attachments     Attachment[]
  missions        Mission[]
  fuelEntries     FuelEntry[]
}

enum DriverStatus {
  ACTIF
  EN_CONGE
  EN_MISSION
  INDISPONIBLE
}

model Driver {
  id                Int                @id @default(autoincrement())
  fullName          String
  cin               String             @unique
  phone             String
  status            DriverStatus       @default(ACTIF)
  note              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  attachments       Attachment[]
  missions          Mission[]
  credential        DriverCredential?
  fuelEntries       FuelEntry[]
  pushSubscriptions PushSubscription[]
}

// Driver-portal login (phone number + PIN). Kept out of `Driver` on purpose
// so credentials can never leak through the existing driver CRUD responses;
// a driver without a row here simply has no portal access.
model DriverCredential {
  id                Int       @id @default(autoincrement())
  driverId          Int       @unique
  // Normalized digits-only phone (see normalizePhone) — the login identifier.
  loginPhone        String    @unique
  pinHash           String
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?
  // Bumped on every PIN reset/revoke; driver JWTs carry it, so older tokens
  // stop working immediately.
  tokenVersion      Int       @default(0)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  driver            Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

// A Web Push subscription — one per driver per browser/device.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  driverId  Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

model Client {
  id             Int             @id @default(autoincrement())
  companyName    String
  address        String?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  ice            String          @unique
  bankName       String?
  bankRib        String?
  bankIban       String?
  bankSwift      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  attachments    Attachment[]
  missions       Mission[]
  clientInvoices ClientInvoice[]
}

model Subcontractor {
  id                 Int                 @id @default(autoincrement())
  companyName        String
  address            String?
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  ice                String              @unique
  bankName           String?
  bankRib            String?
  bankIban           String?
  bankSwift          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  attachments        Attachment[]
  missions           Mission[]
  subcontractorBills SubcontractorBill[]
  contractorTrucks   ContractorTruck[]
}

// A truck belonging to a subcontractor's own fleet, not ours — tracked so a
// SUBCONTRACTED mission can record which specific vehicle is doing the job.
// Deliberately minimal (plate number + owning subcontractor only): unlike
// our own Truck model, we don't manage this vehicle's status, insurance, or
// documents.
model ContractorTruck {
  id              Int           @id @default(autoincrement())
  plateNumber     String        @unique
  subcontractorId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id])
  missions        Mission[]

  @@index([subcontractorId])
}

enum AttachmentOwnerType {
  TRUCK
  DRIVER
  CLIENT
  SUBCONTRACTOR
  CLIENT_INVOICE
  SUBCONTRACTOR_BILL
  MISSION
  FUEL_ENTRY
}

// Optional machine-readable kind on top of the free-text `label`, for files
// the app has rules about (e.g. a mission can't be completed without a CMR).
enum AttachmentCategory {
  CMR
  ODOMETER_PHOTO
  FUEL_RECEIPT
}

// One unified table for every uploaded file across Trucks/Drivers/Clients/
// Subcontractors/ClientInvoices/SubcontractorBills. `label` is a
// human-chosen name set by whoever uploads the file (their responsibility to
// make it recognizable later) — kept separate from `fileName`, the original
// uploaded file's name.
model Attachment {
  id                  Int                 @id @default(autoincrement())
  ownerType           AttachmentOwnerType
  truckId             Int?
  driverId            Int?
  clientId            Int?
  subcontractorId     Int?
  clientInvoiceId     Int?
  subcontractorBillId Int?
  missionId           Int?
  fuelEntryId         Int?
  category            AttachmentCategory?
  label               String
  fileName            String
  filePath            String
  mimeType            String?
  fileSize            Int?
  uploadedAt          DateTime            @default(now())
  deletedAt           DateTime?
  truck               Truck?              @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driver              Driver?             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  client              Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subcontractor       Subcontractor?      @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  clientInvoice       ClientInvoice?      @relation(fields: [clientInvoiceId], references: [id], onDelete: Cascade)
  subcontractorBill   SubcontractorBill?  @relation(fields: [subcontractorBillId], references: [id], onDelete: Cascade)
  mission             Mission?            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  fuelEntry           FuelEntry?          @relation(fields: [fuelEntryId], references: [id], onDelete: Cascade)

  @@index([truckId])
  @@index([driverId])
  @@index([clientId])
  @@index([subcontractorId])
  @@index([clientInvoiceId])
  @@index([subcontractorBillId])
  @@index([missionId])
  @@index([fuelEntryId])
}

enum TransportType {
  EXPORT
  IMPORT
}

enum ExecutionMode {
  IN_HOUSE
  SUBCONTRACTED
}

enum MissionStatus {
  PLANNED
  IN_PROGRESS
  // Driver finished the delivery and uploaded the CMR; ops re-check it
  // before marking it FINISHED.
  PENDING_REVIEW
  FINISHED
  CANCELLED
}

enum Currency {
  MAD
  EUR
}

// The core transaction: a transport job, either run with our own truck+driver
// (IN_HOUSE) or outsourced to a subcontractor (SUBCONTRACTED) — never both,
// enforced in the service layer since Prisma has no declarative XOR.
model Mission {
  id                   Int                @id @default(autoincrement())
  reference            String             @unique
  clientId             Int
  transportType        TransportType
  executionMode        ExecutionMode
  loadingLocation      String
  deliveryLocation     String
  clientPrice          Decimal            @db.Decimal(12, 2)
  currency             Currency
  // EUR→MAD rate at the time of the mission (1 EUR = exchangeRate MAD) —
  // EUR missions only, optional; printed on the client invoice PDF.
  exchangeRate         Decimal?           @db.Decimal(10, 4)
  subcontractorId      Int?
  subcontractorCost    Decimal?           @db.Decimal(12, 2)
  truckId              Int?
  driverId             Int?
  // Which of the subcontractor's own trucks is doing the job — SUBCONTRACTED
  // only, and optional (staff may not have registered the subcontractor's
  // truck yet at mission-creation time).
  contractorTruckId    Int?
  status               MissionStatus      @default(PLANNED)
  // Loading date + time.
  missionDate          DateTime
  expectedDeliveryDate DateTime?
  goods                String?
  weightKg             Int?
  // The client's own reference for this job (e.g. "K+N / AGC").
  clientReference      String?
  // Driver-portal workflow timestamps (see MissionLifecycleService).
  loadingConfirmedAt   DateTime?
  completedAt          DateTime?
  completionComment    String?
  reviewedAt           DateTime?
  autoInvoice          Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  client               Client             @relation(fields: [clientId], references: [id])
  subcontractor        Subcontractor?     @relation(fields: [subcontractorId], references: [id])
  truck                Truck?             @relation(fields: [truckId], references: [id])
  driver               Driver?            @relation(fields: [driverId], references: [id])
  contractorTruck      ContractorTruck?   @relation(fields: [contractorTruckId], references: [id])
  clientInvoice        ClientInvoice?
  subcontractorBill    SubcontractorBill?
  fuelEntries          FuelEntry[]
  attachments          Attachment[]

  @@index([clientId])
  @@index([subcontractorId])
  @@index([truckId])
  @@index([driverId])
  @@index([contractorTruckId])
  @@index([missionDate])
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// Invoice MFAH sends to the client for a mission — amount/currency mirror
// the mission's clientPrice at creation time (single source of truth), not
// entered independently. The PDF itself (made outside the system) is
// uploaded as an Attachment, not stored on this model directly.
model ClientInvoice {
  id            Int           @id @default(autoincrement())
  missionId     Int           @unique
  clientId      Int
  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  currency      Currency
  status        InvoiceStatus @default(UNPAID)
  issueDate     DateTime
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  mission       Mission       @relation(fields: [missionId], references: [id])
  client        Client        @relation(fields: [clientId], references: [id])
  attachments   Attachment[]

  @@index([clientId])
}

// Bill MFAH receives from a subcontractor for a mission it handled —
// amount/currency mirror the mission's subcontractorCost. Kept fully
// separate from ClientInvoice (not polymorphic): the client must never be
// able to reach subcontractor-cost data through any query path.
model SubcontractorBill {
  id              Int           @id @default(autoincrement())
  missionId       Int           @unique
  subcontractorId Int
  billNumber      String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  currency        Currency
  status          InvoiceStatus @default(UNPAID)
  issueDate       DateTime
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  mission         Mission       @relation(fields: [missionId], references: [id])
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id])
  attachments     Attachment[]

  @@index([subcontractorId])
}

// A refuel reported by the driver during an IN_HOUSE mission. Typed by the
// driver (they know what they put in); the optional receipt photo lets ops
// verify it during the PENDING_REVIEW step. Hard-deleted, like attachments:
// a driver removing a typo shouldn't leave a ghost entry behind.
model FuelEntry {
  id          Int          @id @default(autoincrement())
  missionId   Int
  driverId    Int
  truckId     Int?
  litres      Decimal      @db.Decimal(10, 2)
  unitPrice   Decimal      @db.Decimal(10, 3)
  currency    Currency
  totalAmount Decimal      @db.Decimal(12, 2)
  odometerKm  Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  mission     Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  driver      Driver       @relation(fields: [driverId], references: [id])
  truck       Truck?       @relation(fields: [truckId], references: [id])
  attachments Attachment[]

  @@index([missionId])
  @@index([driverId])
}
