generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dom_id      Int?
  jwtToken    String?
  role_id     Int?
  accessToken String?
  doms        doms?    @relation(fields: [dom_id], references: [id])
  roles       roles?   @relation(fields: [role_id], references: [id])
}

model doms {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  address     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  Users       Users[]
  experiences experiences[]
  machines    machines[]
  tickets     tickets[]
  DomeSyncLog DomeSyncLog[]
  domeGames   domeGames[]
}

model experiences {
  id        Int       @id @default(autoincrement())
  machineId Int
  gameId    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  domeId    Int
  tickets   tickets[]
  doms      doms      @relation(fields: [domeId], references: [id], onDelete: SetDefault)
  games     games     @relation(fields: [gameId], references: [id], onDelete: SetDefault)
  machines  machines  @relation(fields: [machineId], references: [id], onDelete: SetDefault)
}

model gameTypes {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  games     games[]
}

model games {
  id            Int           @id @default(autoincrement())
  name          String
  price         Float
  playTime      Int
  gameTypeId    Int?
  age           Int?
  machineTypeId Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  experiences   experiences[]
  domeGames     domeGames[]
  gameTypes     gameTypes?    @relation(fields: [gameTypeId], references: [id])
  machineTypes  machineTypes? @relation(fields: [machineTypeId], references: [id])
}

model domeGames {
  id        Int      @id @default(autoincrement())
  domeId    Int
  gameId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  doms      doms     @relation(fields: [domeId], references: [id], onDelete: SetDefault)
  games     games    @relation(fields: [gameId], references: [id], onDelete: SetDefault)

  @@unique([domeId, gameId])
}

model machineChairs {
  id        Int       @id @default(autoincrement())
  name      String
  status    Int
  machineId Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  machines  machines  @relation(fields: [machineId], references: [id], onDelete: SetDefault)
  tickets   tickets[]
}

model machineTypes {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  games     games[]
  machines  machines[]
}

model machines {
  id            Int             @id @default(autoincrement())
  name          String
  machineTypeId Int?
  domeId        Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  experiences   experiences[]
  machineChairs machineChairs[]
  doms          doms?           @relation(fields: [domeId], references: [id])
  machineTypes  machineTypes?   @relation(fields: [machineTypeId], references: [id])
}

model roles {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  Users     Users[]
}

model tickets {
  id            Int            @id @default(autoincrement())
  userId        Int
  experienceId  Int
  isPaid        Boolean        @default(false)
  chairId       Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  domeId        Int
  experiences   experiences    @relation(fields: [experienceId], references: [id], onDelete: SetDefault)
  machineChairs machineChairs? @relation(fields: [chairId], references: [id])
  doms          doms           @relation(fields: [domeId], references: [id], onDelete: SetDefault)
}

model DomeSyncLog {
  id         Int      @id @default(autoincrement())
  domeId     Int
  lastSyncAt DateTime // The lastSync time received from the dome
  wasSuccess Boolean  @default(true)
  dataCount  Int? // Number of records returned
  error      String? // Error message if failed

  // Relation
  dome doms @relation(fields: [domeId], references: [id], onDelete: Cascade)

  @@index([domeId])
}
