DATABASE_URL="postgres://postgres:postgres@localhost:5432/mfah_project_db"

JWT_ACCESS_SECRET="change-me"
JWT_EXPIRATION_TIME="24h"

# Directory (relative to backend/) where uploaded attachments/contracts are stored
UPLOADS_DIR="./uploads"

# Path to the LibreOffice binary used to convert the populated invoice xlsx
# to PDF — defaults to "soffice" (must be on PATH). LibreOffice and the
# fonts under backend/fonts/ (Neo Sans W23 Black/Light/Medium) must both be
# installed wherever this runs, or the template renders with a fallback
# font and merged cells can clip/misalign.
LIBREOFFICE_BIN="soffice"

# Directory LibreOffice uses as its headless user profile — shared/reused
# across conversions (not recreated per call) to avoid paying its ~5s
# cold-start init every time. Defaults to <os tmpdir>/mfah-invoice-pdf-profile.
# LIBREOFFICE_PROFILE_DIR="/var/lib/mfah/libreoffice-profile"

# The invoice xlsx template's live, replaceable copy lives at a fixed path
# under UPLOADS_DIR (settings/invoice-template.xlsx — see
# src/client-invoice-pdf/services/invoice-template.service.ts) and is
# seeded on first use from this bundled factory default:
# INVOICE_TEMPLATE_DEFAULT_PATH="./templates/invoice-template-default.xlsx"

# Path (relative to backend/) to the plain-text activity log file read/
# written by the admin-only Activity Log module
ACTIVITY_LOG_PATH="./logs/activity.log"
