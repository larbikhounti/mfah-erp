DATABASE_URL="postgres://postgres:postgres@localhost:5432/mfah_project_db"

JWT_ACCESS_SECRET="change-me"
JWT_EXPIRATION_TIME="24h"

# Directory (relative to backend/) where uploaded attachments/contracts are stored
UPLOADS_DIR="./uploads"

# Path (relative to backend/) to the fillable "Facture" PDF template used by
# the client-invoice PDF generator
INVOICE_PDF_TEMPLATE_PATH="./facture_template_editable.pdf"
